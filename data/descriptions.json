{
  "version": 1,
  "_comment": [
    "Description layer for the GUI.",
    "",
    "noise    — regexes matching a 'description' that says nothing to a human;",
    "           such rows fall back to the command itself.",
    "rewrite  — regexes replacing a cryptic description with a readable one,",
    "           per language; {1}, {2} are the regex groups. Checked before noise.",
    "by_key   — last resort for a mapping nobody described: text by the key itself.",
    "translations.<lang> — phrases (whole description, lowercased), tails (the",
    "           trailing parenthesis), words (last-resort, word by word).",
    "",
    "Your own file at ~/.config/nvim-keys/descriptions.json is merged on top."
  ],

  "noise": [
    "^<lua function>$",
    "^which_key_ignore$",
    "^<Plug>\\(",
    "^\\s*$"
  ],

  "rewrite": [
    { "match": "^\\+(.+)$", "en": "Group of keys: {1}", "ru": "Группа сочетаний: {1}" },

    { "match": "^:help (\\S+)-default$",
      "en": "Neovim default mapping (:help {1}-default)",
      "ru": "Стандартное сочетание Neovim (:help {1}-default)" },

    { "match": "^:cnfile$", "en": "First item in the next quickfix file", "ru": "Первый пункт quickfix в следующем файле" },
    { "match": "^:cpfile$", "en": "Last item in the previous quickfix file", "ru": "Последний пункт quickfix в предыдущем файле" },
    { "match": "^:clast$", "en": "Last quickfix item", "ru": "Последний пункт quickfix" },
    { "match": "^:crewind$", "en": "First quickfix item", "ru": "Первый пункт quickfix" },
    { "match": "^:lnext$", "en": "Next item in the location list", "ru": "Следующий пункт списка location" },
    { "match": "^:lprevious$", "en": "Previous item in the location list", "ru": "Предыдущий пункт списка location" },
    { "match": "^:lnfile$", "en": "First location item in the next file", "ru": "Первый пункт location в следующем файле" },
    { "match": "^:lpfile$", "en": "Last location item in the previous file", "ru": "Последний пункт location в предыдущем файле" },
    { "match": "^:llast$", "en": "Last item in the location list", "ru": "Последний пункт списка location" },
    { "match": "^:lrewind$", "en": "First item in the location list", "ru": "Первый пункт списка location" },
    { "match": "^:next$", "en": "Next file in the argument list", "ru": "Следующий файл в списке аргументов" },
    { "match": "^:previous$", "en": "Previous file in the argument list", "ru": "Предыдущий файл в списке аргументов" },
    { "match": "^:last$", "en": "Last file in the argument list", "ru": "Последний файл в списке аргументов" },
    { "match": "^:rewind$", "en": "First file in the argument list", "ru": "Первый файл в списке аргументов" },
    { "match": "^:ptnext$", "en": "Next tag in the preview window", "ru": "Следующий тег в окне предпросмотра" },
    { "match": "^:ptprevious$", "en": "Previous tag in the preview window", "ru": "Предыдущий тег в окне предпросмотра" },
    { "match": "^:tlast$", "en": "Last matching tag", "ru": "Последний подходящий тег" },
    { "match": "^:trewind$", "en": "First matching tag", "ru": "Первый подходящий тег" },

    { "match": "MatchitNormalForward|MatchitOperationForward|MatchitVisualForward|Match_wrapper\\('',1",
      "en": "Jump to the matching bracket or keyword (%)",
      "ru": "Прыжок к парной скобке или ключевому слову (%)" },
    { "match": "MatchitNormalBackward|MatchitOperationBackward|MatchitVisualBackward|Match_wrapper\\('',0",
      "en": "Jump back to the matching bracket or keyword (g%)",
      "ru": "Прыжок назад к парной скобке или ключевому слову (g%)" },
    { "match": "MatchitNormalMultiForward|MatchitOperationMultiForward|MatchitVisualMultiForward|MultiMatch\\(\"W\"",
      "en": "Jump to the end of the surrounding block (]%)",
      "ru": "К концу охватывающего блока (]%)" },
    { "match": "MatchitNormalMultiBackward|MatchitOperationMultiBackward|MatchitVisualMultiBackward|MultiMatch\\(\"bW\"",
      "en": "Jump to the start of the surrounding block ([%)",
      "ru": "К началу охватывающего блока ([%)" },
    { "match": "MatchitVisualTextObject",
      "en": "Select the block between the matching brackets",
      "ru": "Выделить блок между парными скобками" },

    { "match": "^>gv$", "en": "Indent right, the selection stays", "ru": "Отступ вправо, выделение остаётся" },
    { "match": "^<lt>gv$", "en": "Indent left, the selection stays", "ru": "Отступ влево, выделение остаётся" },

    { "match": "^([,.;])<C-G>u$",
      "en": "Type {1} and start a new undo step",
      "ru": "Ввести «{1}» и начать новый шаг отмены" },

    { "match": "telescope\\.builtin'\\)\\.command_history",
      "en": "Command history in Telescope",
      "ru": "История команд в Telescope" },
    { "match": "plenary\\.test_harness",
      "en": "Run the tests of the current file (plenary)",
      "ru": "Запустить тесты текущего файла (plenary)" },

    { "match": "^vim\\.lsp\\.buf\\.code_action\\(\\)$", "en": "Code action from the language server", "ru": "Действие языкового сервера (code action)" },
    { "match": "^vim\\.lsp\\.buf\\.document_symbol\\(\\)$", "en": "Symbols of the current file", "ru": "Символы текущего файла" },
    { "match": "^vim\\.lsp\\.buf\\.implementation\\(\\)$", "en": "Go to the implementation", "ru": "К реализации" },
    { "match": "^vim\\.lsp\\.buf\\.references\\(\\)$", "en": "All references to the symbol", "ru": "Все использования символа" },
    { "match": "^vim\\.lsp\\.buf\\.rename\\(\\)$", "en": "Rename the symbol everywhere", "ru": "Переименовать символ во всём проекте" },
    { "match": "^vim\\.lsp\\.buf\\.type_definition\\(\\)$", "en": "Go to the type definition", "ru": "К определению типа" },
    { "match": "^vim\\.lsp\\.codelens\\.run\\(\\)$", "en": "Run the code lens action", "ru": "Выполнить действие code lens" },

    { "match": "^vim\\.snippet\\.jump if active, otherwise <S-Tab>$",
      "en": "Previous placeholder of the snippet, otherwise Shift+Tab",
      "ru": "К предыдущему полю сниппета, иначе Shift+Tab" },
    { "match": "^vim\\.snippet\\.jump if active, otherwise <Tab>$",
      "en": "Next placeholder of the snippet, otherwise Tab",
      "ru": "К следующему полю сниппета, иначе Tab" },

    { "match": "^MiniPairs <BS>$", "en": "Backspace deletes both brackets of an empty pair", "ru": "Backspace удаляет обе скобки пустой пары" },
    { "match": "^MiniPairs <CR>$", "en": "Enter opens up the pair into a block", "ru": "Enter раскрывает пару скобок в блок" },

    { "match": "^<Cmd>(.+)<CR>$", "en": "Runs :{1}", "ru": "Выполняет :{1}" },
    { "match": "^:(\\S+)$", "en": "Runs :{1}", "ru": "Выполняет :{1}" }
  ],

  "by_key": {
    "f": { "en": "Jump forward to a character in the line", "ru": "Прыжок вперёд к символу в строке" },
    "F": { "en": "Jump backward to a character in the line", "ru": "Прыжок назад к символу в строке" },
    "t": { "en": "Jump forward, stopping before the character", "ru": "Прыжок вперёд, до символа" },
    "T": { "en": "Jump backward, stopping after the character", "ru": "Прыжок назад, до символа" },
    ";": { "en": "Repeat the last f/t jump forward", "ru": "Повторить последний прыжок f/t вперёд" },
    ",": { "en": "Repeat the last f/t jump backward", "ru": "Повторить последний прыжок f/t назад" },
    "n": { "en": "Next search match", "ru": "Следующее совпадение поиска" },
    "N": { "en": "Previous search match", "ru": "Предыдущее совпадение поиска" },
    "s": { "en": "Jump by labels (flash)", "ru": "Прыжок по меткам (flash)" },
    "S": { "en": "Jump by treesitter nodes (flash)", "ru": "Прыжок по узлам treesitter (flash)" }
  },

